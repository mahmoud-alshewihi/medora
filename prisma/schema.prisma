generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum RoleKey {
  SUPER_ADMIN
  CLINIC_OWNER
  BRANCH_MANAGER
  DOCTOR
  RECEPTIONIST
  ACCOUNTANT
  NURSE
  PATIENT
}

enum ClinicStatus {
  ACTIVE
  SUSPENDED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  EXPIRED
  CANCELLED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  WAITING
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentSource {
  ONLINE
  RECEPTION
  WALK_IN
  PORTAL
  FOLLOW_UP
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  MOBILE_WALLET
}

enum PaymentKind {
  OFFLINE_RECORDED
}

enum StockMovementType {
  PURCHASE_RECEIPT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  CONSUMPTION
  TRANSFER_IN
  TRANSFER_OUT
  EXPIRED_WRITE_OFF
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  RECEIVED
  CANCELLED
}

enum NotificationType {
  APPOINTMENT_NEW
  APPOINTMENT_CONFIRMED
  APPOINTMENT_CANCELLED
  APPOINTMENT_REMINDER
  PATIENT_CHECKIN
  INVOICE_OUTSTANDING
  INVENTORY_LOW
  INVENTORY_EXPIRING
  ADMIN_EVENT
}

enum LabStatus {
  REQUESTED
  COLLECTED
  COMPLETED
  CANCELLED
}

// ---------- Better Auth core ----------
model User {
  id                String                   @id
  name              String
  email             String                   @unique
  emailVerified     Boolean                  @default(false)
  image             String?
  status            UserStatus               @default(ACTIVE)
  locale            String                   @default("en")
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  sessions          Session[]
  accounts          Account[]
  memberships       Membership[]
  notifications     Notification[]
  notificationPrefs NotificationPreference[]
  auditLogs         AuditLog[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---------- Platform ----------
model SubscriptionPlan {
  id            String         @id @default(cuid())
  code          String         @unique
  name          String
  priceMonthly  Decimal        @db.Decimal(12, 2)
  maxBranches   Int
  maxDoctors    Int
  maxPatients   Int
  active        Boolean        @default(true)
  subscriptions Subscription[]
}

model Subscription {
  id        String             @id @default(cuid())
  clinicId  String             @unique
  clinic    Clinic             @relation(fields: [clinicId], references: [id])
  planId    String
  plan      SubscriptionPlan   @relation(fields: [planId], references: [id])
  status    SubscriptionStatus
  startsAt  DateTime
  expiresAt DateTime
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
}

model Clinic {
  id             String          @id @default(cuid())
  slug           String          @unique
  name           String
  nameAr         String?
  description    String?
  status         ClinicStatus    @default(ACTIVE)
  currency       String          @default("EGP")
  timezone       String          @default("Africa/Cairo")
  locale         String          @default("en")
  logoUrl        String?
  primaryColor   String          @default("#0f766e")
  phone          String?
  email          String?
  address        String?
  invoicePrefix  String          @default("INV")
  invoiceFooter  String?
  taxRatePercent Decimal         @default(0) @db.Decimal(5, 2)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  branches       Branch[]
  memberships    Membership[]
  subscription   Subscription?
  patients       Patient[]
  specialties    Specialty[]
  services       Service[]
  doctors        Doctor[]
  employees      Employee[]
  holidays       Holiday[]
  appointments   Appointment[]
  invoices       Invoice[]
  expenses       Expense[]
  suppliers      Supplier[]
  inventoryItems InventoryItem[]
  notifications  Notification[]
  auditLogs      AuditLog[]
  testimonials   Testimonial[]
  faqs           Faq[]
  cashRegisters  CashRegister[]
  purchaseOrders PurchaseOrder[]
}

model Branch {
  id              String           @id @default(cuid())
  clinicId        String
  clinic          Clinic           @relation(fields: [clinicId], references: [id])
  name            String
  city            String?
  address         String?
  phone           String?
  workingHours    Json // { "0": ["09:00","17:00"], ... } weekday -> open/close, absent = closed
  active          Boolean          @default(true)
  createdAt       DateTime         @default(now())
  memberships     Membership[]
  doctorSchedules DoctorSchedule[]
  appointments    Appointment[]
  invoices        Invoice[]
  expenses        Expense[]
  stockLevels     InventoryBatch[]
  cashRegisters   CashRegister[]
  employees       Employee[]

  @@unique([clinicId, name])
  @@index([clinicId])
}

model Role {
  id          String           @id @default(cuid())
  key         RoleKey          @unique
  name        String
  permissions RolePermission[]
  memberships Membership[]
}

model Permission {
  id    String           @id @default(cuid())
  code  String           @unique
  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Membership {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id])
  clinicId  String? // null only for SUPER_ADMIN
  clinic    Clinic?  @relation(fields: [clinicId], references: [id])
  branchId  String? // null = all branches of clinic
  branch    Branch?  @relation(fields: [branchId], references: [id])
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([userId, clinicId])
  @@index([clinicId])
}

// ---------- Clinical master data ----------
model Specialty {
  id          String    @id @default(cuid())
  clinicId    String
  clinic      Clinic    @relation(fields: [clinicId], references: [id])
  name        String
  nameAr      String?
  description String?
  doctors     Doctor[]
  services    Service[]

  @@unique([clinicId, name])
}

model Service {
  id           String        @id @default(cuid())
  clinicId     String
  clinic       Clinic        @relation(fields: [clinicId], references: [id])
  specialtyId  String?
  specialty    Specialty?    @relation(fields: [specialtyId], references: [id])
  name         String
  nameAr       String?
  description  String?
  price        Decimal       @db.Decimal(12, 2)
  durationMin  Int           @default(30)
  active       Boolean       @default(true)
  invoiceItems InvoiceItem[]

  @@unique([clinicId, name])
}

model Doctor {
  id                String           @id @default(cuid())
  clinicId          String
  clinic            Clinic           @relation(fields: [clinicId], references: [id])
  userId            String?          @unique
  fullName          String
  specialtyId       String
  specialty         Specialty        @relation(fields: [specialtyId], references: [id])
  bio               String?
  qualifications    String?
  yearsExperience   Int              @default(0)
  consultationFee   Decimal          @db.Decimal(12, 2)
  commissionPercent Decimal          @default(0) @db.Decimal(5, 2)
  slotDurationMin   Int              @default(30)
  active            Boolean          @default(true)
  schedules         DoctorSchedule[]
  vacations         DoctorVacation[]
  appointments      Appointment[]
  consultations     Consultation[]
  prescriptions     Prescription[]
  commissions       Commission[]

  @@index([clinicId])
}

model DoctorSchedule {
  id         String  @id @default(cuid())
  doctorId   String
  doctor     Doctor  @relation(fields: [doctorId], references: [id])
  branchId   String
  branch     Branch  @relation(fields: [branchId], references: [id])
  weekday    Int // 0=Sunday..6=Saturday in clinic timezone
  startTime  String // HH:mm
  endTime    String
  breakStart String?
  breakEnd   String?

  @@index([doctorId, weekday])
}

model DoctorVacation {
  id        String   @id @default(cuid())
  doctorId  String
  doctor    Doctor   @relation(fields: [doctorId], references: [id])
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  reason    String?
}

model Holiday {
  id       String   @id @default(cuid())
  clinicId String
  clinic   Clinic   @relation(fields: [clinicId], references: [id])
  branchId String?
  date     DateTime @db.Date
  name     String

  @@index([clinicId, date])
}

model Employee {
  id       String   @id @default(cuid())
  clinicId String
  clinic   Clinic   @relation(fields: [clinicId], references: [id])
  userId   String?  @unique
  branchId String?
  branch   Branch?  @relation(fields: [branchId], references: [id])
  fullName String
  jobTitle String
  phone    String?
  active   Boolean  @default(true)
  hiredAt  DateTime @default(now())

  @@index([clinicId])
}

// ---------- Patients ----------
model Patient {
  id                       String              @id @default(cuid())
  clinicId                 String
  clinic                   Clinic              @relation(fields: [clinicId], references: [id])
  userId                   String?             @unique // portal account
  mrn                      String // unique patient identification number per clinic
  fullName                 String
  gender                   Gender?
  dateOfBirth              DateTime?           @db.Date
  phone                    String?
  email                    String?
  nationalId               String?
  address                  String?
  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?
  allergies                String[]            @default([])
  chronicConditions        String[]            @default([])
  medicalHistory           String?
  archivedAt               DateTime?
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt
  appointments             Appointment[]
  consultations            Consultation[]
  prescriptions            Prescription[]
  invoices                 Invoice[]
  attachments              PatientAttachment[]
  notes                    PatientNote[]
  labRequests              LaboratoryRequest[]
  medicalRecords           MedicalRecord[]

  @@unique([clinicId, mrn])
  @@index([clinicId, fullName])
  @@index([clinicId, phone])
}

model PatientNote {
  id           String   @id @default(cuid())
  patientId    String
  patient      Patient  @relation(fields: [patientId], references: [id])
  authorUserId String
  body         String
  createdAt    DateTime @default(now())
}

model PatientAttachment {
  id             String   @id @default(cuid())
  patientId      String
  patient        Patient  @relation(fields: [patientId], references: [id])
  clinicId       String
  fileName       String
  storageKey     String // never exposed; served via authorized route only
  mimeType       String
  sizeBytes      Int
  uploadedById   String
  patientVisible Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([patientId])
}

// ---------- Appointments ----------
model Appointment {
  id             String                     @id @default(cuid())
  clinicId       String
  clinic         Clinic                     @relation(fields: [clinicId], references: [id])
  branchId       String
  branch         Branch                     @relation(fields: [branchId], references: [id])
  doctorId       String
  doctor         Doctor                     @relation(fields: [doctorId], references: [id])
  patientId      String
  patient        Patient                    @relation(fields: [patientId], references: [id])
  serviceId      String?
  reference      String                     @unique
  startsAt       DateTime
  endsAt         DateTime
  status         AppointmentStatus          @default(PENDING)
  source         AppointmentSource          @default(RECEPTION)
  reason         String?
  queueNumber    Int?
  queueDate      DateTime?                  @db.Date
  checkedInAt    DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  cancelReason   String?
  reminderSentAt DateTime?
  createdById    String?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
  history        AppointmentStatusHistory[]
  consultation   Consultation?
  invoice        Invoice?

  @@index([clinicId, startsAt])
  @@index([doctorId, startsAt])
  @@index([patientId])
  @@index([branchId, status, startsAt])
}

model AppointmentStatusHistory {
  id            String             @id @default(cuid())
  appointmentId String
  appointment   Appointment        @relation(fields: [appointmentId], references: [id])
  fromStatus    AppointmentStatus?
  toStatus      AppointmentStatus
  actorUserId   String?
  note          String?
  createdAt     DateTime           @default(now())

  @@index([appointmentId])
}

// ---------- Clinical ----------
model MedicalRecord {
  id             String   @id @default(cuid())
  patientId      String
  patient        Patient  @relation(fields: [patientId], references: [id])
  clinicId       String
  kind           String // DIAGNOSIS | TREATMENT_PLAN | NOTE
  title          String
  body           String
  icd10          String?
  authorDoctorId String?
  createdAt      DateTime @default(now())

  @@index([patientId, createdAt])
}

model Consultation {
  id            String              @id @default(cuid())
  appointmentId String              @unique
  appointment   Appointment         @relation(fields: [appointmentId], references: [id])
  clinicId      String
  patientId     String
  patient       Patient             @relation(fields: [patientId], references: [id])
  doctorId      String
  doctor        Doctor              @relation(fields: [doctorId], references: [id])
  complaint     String?
  clinicalNotes String?
  vitals        Json? // bpSystolic, bpDiastolic, heartRate, tempC, weightKg, heightCm, spo2
  diagnosis     String?
  treatmentPlan String?
  followUpDate  DateTime?           @db.Date
  completedAt   DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  prescriptions Prescription[]
  labRequests   LaboratoryRequest[]
}

model Prescription {
  id             String             @id @default(cuid())
  clinicId       String
  consultationId String
  consultation   Consultation       @relation(fields: [consultationId], references: [id])
  patientId      String
  patient        Patient            @relation(fields: [patientId], references: [id])
  doctorId       String
  doctor         Doctor             @relation(fields: [doctorId], references: [id])
  number         String             @unique
  issuedAt       DateTime           @default(now())
  notes          String?
  items          PrescriptionItem[]
}

model PrescriptionItem {
  id             String       @id @default(cuid())
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medication     String
  dosage         String
  frequency      String
  duration       String
  instructions   String?
}

model LaboratoryRequest {
  id             String       @id @default(cuid())
  clinicId       String
  consultationId String
  consultation   Consultation @relation(fields: [consultationId], references: [id])
  patientId      String
  patient        Patient      @relation(fields: [patientId], references: [id])
  testName       String
  notes          String?
  status         LabStatus    @default(REQUESTED)
  resultText     String?
  createdAt      DateTime     @default(now())
}

// ---------- Billing ----------
model Invoice {
  id             String        @id @default(cuid())
  clinicId       String
  clinic         Clinic        @relation(fields: [clinicId], references: [id])
  branchId       String
  branch         Branch        @relation(fields: [branchId], references: [id])
  patientId      String
  patient        Patient       @relation(fields: [patientId], references: [id])
  appointmentId  String?       @unique
  appointment    Appointment?  @relation(fields: [appointmentId], references: [id])
  number         String
  status         InvoiceStatus @default(ISSUED)
  currency       String        @default("EGP")
  subtotal       Decimal       @db.Decimal(12, 2)
  discountAmount Decimal       @default(0) @db.Decimal(12, 2)
  taxAmount      Decimal       @default(0) @db.Decimal(12, 2)
  total          Decimal       @db.Decimal(12, 2)
  paidAmount     Decimal       @default(0) @db.Decimal(12, 2)
  refundedAmount Decimal       @default(0) @db.Decimal(12, 2)
  issuedAt       DateTime      @default(now())
  dueDate        DateTime?
  notes          String?
  createdById    String?
  items          InvoiceItem[]
  payments       Payment[]
  commissions    Commission[]

  @@unique([clinicId, number])
  @@index([clinicId, status])
  @@index([patientId])
  @@index([branchId, issuedAt])
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  serviceId   String?
  service     Service? @relation(fields: [serviceId], references: [id])
  description String
  quantity    Int
  unitPrice   Decimal  @db.Decimal(12, 2)
  lineTotal   Decimal  @db.Decimal(12, 2)
}

model CashRegister {
  id             String    @id @default(cuid())
  clinicId       String
  clinic         Clinic    @relation(fields: [clinicId], references: [id])
  branchId       String
  branch         Branch    @relation(fields: [branchId], references: [id])
  businessDate   DateTime  @db.Date
  openingBalance Decimal   @default(0) @db.Decimal(12, 2)
  expectedCash   Decimal?  @db.Decimal(12, 2)
  countedCash    Decimal?  @db.Decimal(12, 2)
  closedAt       DateTime?
  closedById     String?
  payments       Payment[]

  @@unique([branchId, businessDate])
}

model Payment {
  id             String        @id @default(cuid())
  invoiceId      String
  invoice        Invoice       @relation(fields: [invoiceId], references: [id])
  clinicId       String
  amount         Decimal       @db.Decimal(12, 2)
  method         PaymentMethod
  kind           PaymentKind   @default(OFFLINE_RECORDED)
  reference      String?
  idempotencyKey String
  receiptNumber  String
  receivedById   String?
  cashRegisterId String?
  cashRegister   CashRegister? @relation(fields: [cashRegisterId], references: [id])
  paidAt         DateTime      @default(now())
  refunds        Refund[]

  @@unique([clinicId, idempotencyKey])
  @@unique([clinicId, receiptNumber])
  @@index([clinicId, paidAt])
}

model Refund {
  id             String   @id @default(cuid())
  paymentId      String
  payment        Payment  @relation(fields: [paymentId], references: [id])
  clinicId       String
  amount         Decimal  @db.Decimal(12, 2)
  reason         String
  idempotencyKey String
  createdById    String?
  createdAt      DateTime @default(now())

  @@unique([clinicId, idempotencyKey])
}

model ExpenseCategory {
  id       String    @id @default(cuid())
  clinicId String
  name     String
  expenses Expense[]

  @@unique([clinicId, name])
}

model Expense {
  id          String          @id @default(cuid())
  clinicId    String
  clinic      Clinic          @relation(fields: [clinicId], references: [id])
  branchId    String?
  branch      Branch?         @relation(fields: [branchId], references: [id])
  categoryId  String
  category    ExpenseCategory @relation(fields: [categoryId], references: [id])
  description String
  amount      Decimal         @db.Decimal(12, 2)
  incurredOn  DateTime        @db.Date
  createdById String?
  createdAt   DateTime        @default(now())

  @@index([clinicId, incurredOn])
}

model Commission {
  id        String   @id @default(cuid())
  clinicId  String
  doctorId  String
  doctor    Doctor   @relation(fields: [doctorId], references: [id])
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id])
  percent   Decimal  @db.Decimal(5, 2)
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  @@unique([invoiceId, doctorId])
  @@index([clinicId, createdAt])
}

// ---------- Inventory ----------
model Supplier {
  id       String          @id @default(cuid())
  clinicId String
  clinic   Clinic          @relation(fields: [clinicId], references: [id])
  name     String
  phone    String?
  email    String?
  items    PurchaseOrder[]

  @@unique([clinicId, name])
}

model InventoryCategory {
  id       String          @id @default(cuid())
  clinicId String
  name     String
  items    InventoryItem[]

  @@unique([clinicId, name])
}

model InventoryItem {
  id         String              @id @default(cuid())
  clinicId   String
  clinic     Clinic              @relation(fields: [clinicId], references: [id])
  categoryId String
  category   InventoryCategory   @relation(fields: [categoryId], references: [id])
  sku        String
  name       String
  unit       String              @default("unit")
  minStock   Int                 @default(0)
  active     Boolean             @default(true)
  batches    InventoryBatch[]
  movements  StockMovement[]
  poLines    PurchaseOrderLine[]

  @@unique([clinicId, sku])
}

model InventoryBatch {
  id          String          @id @default(cuid())
  itemId      String
  item        InventoryItem   @relation(fields: [itemId], references: [id])
  branchId    String
  branch      Branch          @relation(fields: [branchId], references: [id])
  batchNumber String
  expiresOn   DateTime?       @db.Date
  quantity    Int
  movements   StockMovement[]

  @@unique([itemId, branchId, batchNumber])
  @@index([branchId, expiresOn])
}

model StockMovement {
  id            String            @id @default(cuid())
  clinicId      String
  itemId        String
  item          InventoryItem     @relation(fields: [itemId], references: [id])
  batchId       String
  batch         InventoryBatch    @relation(fields: [batchId], references: [id])
  branchId      String
  type          StockMovementType
  quantityDelta Int
  balanceAfter  Int
  reason        String?
  refId         String?
  actorUserId   String?
  createdAt     DateTime          @default(now())

  @@index([clinicId, createdAt])
  @@index([itemId])
}

model PurchaseOrder {
  id         String              @id @default(cuid())
  clinicId   String
  clinic     Clinic              @relation(fields: [clinicId], references: [id])
  supplierId String
  supplier   Supplier            @relation(fields: [supplierId], references: [id])
  branchId   String
  number     String
  status     PurchaseOrderStatus @default(DRAFT)
  createdAt  DateTime            @default(now())
  receivedAt DateTime?
  lines      PurchaseOrderLine[]

  @@unique([clinicId, number])
}

model PurchaseOrderLine {
  id          String        @id @default(cuid())
  orderId     String
  order       PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemId      String
  item        InventoryItem @relation(fields: [itemId], references: [id])
  quantity    Int
  unitCost    Decimal       @db.Decimal(12, 2)
  batchNumber String?
  expiresOn   DateTime?     @db.Date
}

// ---------- Notifications / audit / content ----------
model Notification {
  id             String           @id @default(cuid())
  clinicId       String
  clinic         Clinic           @relation(fields: [clinicId], references: [id])
  userId         String
  user           User             @relation(fields: [userId], references: [id])
  type           NotificationType
  title          String
  body           String
  link           String?
  readAt         DateTime?
  dedupeKey      String?
  deliveryStatus String           @default("IN_APP_ONLY") // external delivery is NOT_CONFIGURED unless a provider is set
  createdAt      DateTime         @default(now())

  @@unique([userId, dedupeKey])
  @@index([userId, readAt, createdAt])
}

model NotificationPreference {
  id     String           @id @default(cuid())
  userId String
  user   User             @relation(fields: [userId], references: [id])
  type   NotificationType
  inApp  Boolean          @default(true)
  email  Boolean          @default(false)

  @@unique([userId, type])
}

model AuditLog {
  id        String   @id @default(cuid())
  clinicId  String?
  clinic    Clinic?  @relation(fields: [clinicId], references: [id])
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([clinicId, createdAt])
  @@index([entity, entityId])
}

model Testimonial {
  id       String  @id @default(cuid())
  clinicId String
  clinic   Clinic  @relation(fields: [clinicId], references: [id])
  author   String
  quote    String
  isDemo   Boolean @default(true)
}

model Faq {
  id       String @id @default(cuid())
  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id])
  question String
  answer   String
  position Int    @default(0)
}

model IdempotencyKey {
  key       String   @id
  scope     String
  response  Json?
  createdAt DateTime @default(now())
}

model Counter {
  key   String @id
  value Int    @default(0)
}
